---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostRow from '~/components/PostRow.astro';
import { getAllPosts, tagCounts, groupByYear } from '~/lib/posts';

const posts = await getAllPosts();
const tags = tagCounts(posts);
const years = groupByYear(posts);
---

<BaseLayout title="전체 글" description="developjik 블로그의 모든 글 — 프론트엔드, AI 운영, 웹 플랫폼 아티클 전체 목록.">
  <div class="shell py-14 md:py-20">
    <header class="mb-10" data-reveal>
      <p class="kicker mb-3">All Posts</p>
      <h1 class="font-display text-4xl font-bold tracking-tight md:text-5xl">전체 글</h1>
      <p class="mt-4 font-mono text-sm text-faint">
        <span class="tabular" id="post-count">{posts.length}</span> posts · <span class="tabular">{tags.length}</span> tags · since 2024
      </p>
    </header>

    <!-- filter bar -->
    <div class="sticky top-[4.25rem] z-20 -mx-5 mb-10 border-b border-line bg-bg/90 px-5 py-4 backdrop-blur-md sm:-mx-8 sm:px-8" data-reveal>
      <div class="flex items-center gap-3">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-faint"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input
          id="posts-filter"
          type="text"
          placeholder="제목 · 설명 · 태그로 필터…"
          autocomplete="off"
          class="w-full bg-transparent text-sm text-ink outline-none placeholder:text-faint"
          aria-label="글 검색"
        />
        <span class="kbd shrink-0">ESC</span>
      </div>
      <div class="mt-3 flex flex-wrap gap-1.5" id="posts-tags">
        <button type="button" class="chip chip-active" data-filter-tag="">전체</button>
        {tags.slice(0, 12).map(([tag, count]) => (
          <button type="button" class="chip" data-filter-tag={tag}>{tag} <span class="tabular opacity-60">{count}</span></button>
        ))}
        <a href="/tags" class="chip">+{Math.max(0, tags.length - 12)}개 태그 →</a>
      </div>
    </div>

    <!-- list -->
    <div id="posts-list" class="space-y-14">
      {years.map(([year, list]) => (
        <section data-year-group>
          <div class="mb-5 flex items-baseline gap-4">
            <h2 class="font-display text-2xl font-bold text-accent tabular">{year}</h2>
            <span class="font-mono text-xs text-faint tabular">{list.length}편</span>
            <span class="h-px flex-1 bg-line" aria-hidden></span>
          </div>
          <div class="timeline-rail ml-1">
            {list.map((p) => (
              <div data-post data-title={p.data.title.toLowerCase()} data-desc={p.data.description.toLowerCase()} data-tags={p.data.tags.join(',').toLowerCase()}>
                <PostRow post={p} />
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p id="posts-empty" class="hidden py-16 text-center font-mono text-sm text-faint">
      조건에 맞는 글이 없습니다 — 필터를 초기화해 보세요
    </p>
  </div>

  <script>
    function initPostsFilter() {
      const inputEl = document.getElementById('posts-filter') as HTMLInputElement | null;
      const rows = Array.from(document.querySelectorAll('[data-post]'));
      const groups = Array.from(document.querySelectorAll('[data-year-group]'));
      const countEl = document.getElementById('post-count');
      const emptyEl = document.getElementById('posts-empty');
      const tagBtns = Array.from(document.querySelectorAll('[data-filter-tag]'));
      if (!inputEl) return;
      if (inputEl.dataset.initialized === '1') return;
      inputEl.dataset.initialized = '1';
      const input: HTMLInputElement = inputEl;

      let activeTag = '';

      function apply() {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const row of rows) {
          const title = row.getAttribute('data-title') ?? '';
          const desc = row.getAttribute('data-desc') ?? '';
          const tags = row.getAttribute('data-tags') ?? '';
          const okQ = !q || title.includes(q) || desc.includes(q) || tags.includes(q);
          const okT = !activeTag || tags.split(',').includes(activeTag);
          const ok = okQ && okT;
          (row as HTMLElement).style.display = ok ? '' : 'none';
          if (ok) shown++;
        }
        for (const g of groups) {
          const any = g.querySelectorAll('[data-post]').length > 0 && Array.from(g.querySelectorAll('[data-post]')).some((r) => (r as HTMLElement).style.display !== 'none');
          (g as HTMLElement).style.display = any ? '' : 'none';
        }
        if (countEl) countEl.textContent = String(shown);
        if (emptyEl) emptyEl.classList.toggle('hidden', shown > 0);
      }

      input.addEventListener('input', apply);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { input.value = ''; apply(); input.blur(); }
        if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus(); }
      });

      for (const btn of tagBtns) {
        btn.addEventListener('click', () => {
          activeTag = (btn.getAttribute('data-filter-tag') ?? '').toLowerCase();
          for (const b of tagBtns) b.classList.toggle('chip-active', b === btn);
          apply();
        });
      }

      document.addEventListener('keydown', (e) => {
        const typing = ['input', 'textarea'].includes((document.activeElement as HTMLElement)?.tagName?.toLowerCase() ?? '');
        if (e.key === '/' && !typing) { e.preventDefault(); input.focus(); }
      });
    }
    document.addEventListener('astro:page-load', initPostsFilter);
    initPostsFilter();
  </script>
</BaseLayout>
