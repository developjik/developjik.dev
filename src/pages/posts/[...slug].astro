---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Toc from '~/components/Toc.astro';
import ShareButtons from '~/components/ShareButtons.astro';
import PostCard from '~/components/PostCard.astro';
import Giscus from '~/components/Giscus.tsx';
import { SITE } from '~/consts';
import {
  getAllPosts,
  getSeriesPosts,
  readingMinutes,
  relatedPosts,
  seriesIdOf,
  SERIES,
  formatDate,
  isoDate,
  tagSlug,
} from '~/lib/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body ?? '');
const allPosts = await getAllPosts();
const seriesId = seriesIdOf(post.id);
const series = seriesId ? SERIES[seriesId] : undefined;
const seriesList = seriesId ? getSeriesPosts(allPosts, seriesId) : [];
const epIndex = seriesList.findIndex((p) => p.id === post.id);
const prevEp = epIndex > 0 ? seriesList[epIndex - 1] : undefined;
const nextEp = epIndex >= 0 && epIndex < seriesList.length - 1 ? seriesList[epIndex + 1] : undefined;
const related = relatedPosts(post, allPosts, 3);
const postUrl = new URL('/posts/' + post.id, SITE.url).href;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: 'ko',
  keywords: post.data.tags.join(', '),
  author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  image: new URL('/og/' + post.id + '.png', SITE.url).href,
  wordCount: (post.body ?? '').length,
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={'/og/' + post.id + '.png'}
  type="article"
  jsonLd={jsonLd}
  publishedTime={post.data.date.toISOString()}
  tags={post.data.tags}
>
  <div id="reading-progress" aria-hidden="true"></div>

  <div class="shell relative pt-12 md:pt-16" id="top">
    <div class="mx-auto grid max-w-6xl gap-10 xl:grid-cols-[minmax(0,1fr)_15rem]">
      <div class="mx-auto w-full max-w-[45rem] xl:mx-0">
        <article data-pagefind-body>
          <!-- header -->
          <header class="mb-10 border-b border-line pb-10">
            {series && (
              <p class="mb-4">
                <a href={'/series/' + series.id} class="inline-flex items-center gap-1.5 rounded-full border border-line bg-accent-soft px-3 py-1 text-[0.7rem] font-semibold text-accent transition-colors hover:border-accent">
                  {series.short}
                  {epIndex >= 0 && <span class="tabular text-faint">· EP {String(epIndex + 1).padStart(2, '0')}</span>}
                </a>
              </p>
            )}
            <h1 class="text-balance font-display text-[1.9rem] font-bold leading-[1.25] tracking-tight md:text-[2.4rem]">
              {post.data.title}
            </h1>
            {post.data.description && (
              <p class="mt-4 border-l-2 border-accent pl-4 text-[0.95rem] leading-relaxed text-soft">{post.data.description}</p>
            )}
            <div class="meta-row mt-7">
              <time datetime={post.data.date.toISOString()} data-pagefind-meta="date">{formatDate(post.data.date)}</time>
              <span aria-hidden>·</span>
              <span>{minutes}분 읽기</span>
              <div class="ml-auto flex items-center gap-3">
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.slice(0, 4).map((t) => (
                    <a href={'/tags/' + tagSlug(t)} class="chip">{t}</a>
                  ))}
                </div>
                <ShareButtons title={post.data.title} url={postUrl} />
              </div>
            </div>
          </header>

          <!-- body -->
          <div class="prose">
            <Content />
          </div>
        </article>

        <!-- series nav -->
        {series && epIndex >= 0 && (
          <nav aria-label="시리즈 내비게이션" class="card mt-14 p-6 no-print">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
              <p class="font-mono text-xs text-faint">
                시리즈 · <a class="u" href={'/series/' + series.id}>{series.title}</a>
              </p>
              <p class="font-mono text-xs text-faint tabular">EP {String(epIndex + 1).padStart(2, '0')} / {seriesList.length}</p>
            </div>
            <div class="series-bar mb-5"><div style={'width:' + (((epIndex + 1) / seriesList.length) * 100) + '%'}></div></div>
            <div class="grid gap-3 sm:grid-cols-2">
              {prevEp ? (
                <a href={'/posts/' + prevEp.id} class="group rounded-md border border-line p-3.5 transition-colors hover:border-accent">
                  <p class="mb-1 font-mono text-[0.65rem] text-faint">← 이전 편</p>
                  <p class="line-clamp-1 text-sm font-[550] transition-colors group-hover:text-accent">{prevEp.data.title}</p>
                </a>
              ) : <span />}
              {nextEp ? (
                <a href={'/posts/' + nextEp.id} class="group rounded-md border border-line p-3.5 text-right transition-colors hover:border-accent">
                  <p class="mb-1 font-mono text-[0.65rem] text-faint">다음 편 →</p>
                  <p class="line-clamp-1 text-sm font-[550] transition-colors group-hover:text-accent">{nextEp.data.title}</p>
                </a>
              ) : <span />}
            </div>
          </nav>
        )}

        <!-- related -->
        {related.length > 0 && (
          <section class="mt-16 no-print" aria-label="관련 글">
            <p class="kicker mb-5">Related</p>
            <div class="grid gap-4 sm:grid-cols-3">
              {related.map((p) => <PostCard post={p} minutes={readingMinutes(p.body ?? '')} />)}
            </div>
          </section>
        )}

        <!-- comments -->
        <Giscus client:visible />
      </div>

      <!-- toc rail -->
      <aside class="hidden xl:block">
        <div class="sticky top-24">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>

    <div class="mx-auto mt-16 max-w-[45rem] border-t border-line pt-7 no-print">
      <a href="/posts" class="font-mono text-xs text-faint transition-colors hover:text-accent">← 전체 글로 돌아가기</a>
    </div>
  </div>

  <script>
    function initPostPage() {
      const pg = document.getElementById('reading-progress');
      if (pg && pg.dataset.initialized === '1') return;
      if (pg) pg.dataset.initialized = '1';
      // reading progress
      const bar = document.getElementById('reading-progress');
      const article = document.querySelector('[data-pagefind-body]');
      if (bar && article) {
        const update = () => {
          const rect = article.getBoundingClientRect();
          const total = rect.height - window.innerHeight + 200;
          const done = Math.min(1, Math.max(0, -rect.top / Math.max(1, total)));
          bar.style.transform = 'scaleX(' + done + ')';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }

      // toc active heading
      const tocLinks = document.querySelectorAll('[data-toc-link]');
      if (tocLinks.length > 0) {
        const map = new Map<string, HTMLElement>();
        tocLinks.forEach((l) => {
          const href = l.getAttribute('href') ?? '';
          const target = href.startsWith('#') ? document.getElementById(href.slice(1)) : null;
          if (target) map.set(target.id, l as HTMLElement);
        });
        if ('IntersectionObserver' in window && map.size > 0) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const en of entries) {
                if (en.isIntersecting) {
                  tocLinks.forEach((l) => l.classList.remove('active'));
                  map.get(en.target.id)?.classList.add('active');
                }
              }
            },
            { rootMargin: '-15% 0px -70% 0px' },
          );
          map.forEach((_, id) => {
            const el = document.getElementById(id);
            if (el) io.observe(el);
          });
        }
      }

      // copy link
      document.querySelectorAll('[data-copy-link]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url') ?? window.location.href;
          try {
            await navigator.clipboard.writeText(url);
            const original = btn.getAttribute('aria-label');
            btn.setAttribute('aria-label', '복사됨!');
            setTimeout(() => btn.setAttribute('aria-label', original ?? '링크 복사'), 1500);
          } catch (e) {
            window.prompt('이 URL을 복사하세요:', url);
          }
        });
      });
    }
    document.addEventListener('astro:page-load', initPostPage);
    initPostPage();
  </script>
</BaseLayout>
