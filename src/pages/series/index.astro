---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SeriesCard from '~/components/SeriesCard.astro';
import { getAllPosts, getAllSeries } from '~/lib/posts';

const posts = await getAllPosts();
const series = getAllSeries(posts);
---

<BaseLayout title="시리즈" description="developjik 블로그의 연재 시리즈 — 하나의 주제를 끝까지 파는 운영 플레이북 모음.">
  <div class="shell py-14 md:py-20">
    <header class="mb-12" data-reveal>
      <p class="kicker mb-3">Series</p>
      <h1 class="font-display text-4xl font-bold tracking-tight md:text-5xl">시리즈</h1>
      <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-soft">
        짧은 팁 대신, 하나의 주제를 설계부터 운영까지 끝까지 파는 연재를 지향합니다.
      </p>
    </header>

    <div class="grid gap-5" data-reveal>
      {series.map((s) => <SeriesCard series={s} />)}
    </div>
  </div>
</BaseLayout>
