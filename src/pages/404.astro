---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="404 — 페이지를 찾을 수 없습니다" description="요청한 페이지가 없습니다.">
  <div class="shell flex min-h-[60vh] max-w-2xl flex-col justify-center py-20">
    <p class="font-display text-[clamp(4.5rem,16vw,9rem)] font-bold leading-none tracking-tight" data-reveal>
      404<span class="text-accent">.</span>
    </p>
    <p class="kicker mt-8" data-reveal>Page not found — {Astro.url.pathname}</p>
    <h1 class="mt-4 font-display text-3xl font-bold tracking-tight md:text-4xl" data-reveal>
      요청한 쪽은 이 문집에 없습니다
    </h1>
    <p class="mt-4 text-soft" data-reveal>
      옮겨지거나 삭제된 주소예요. 아래에서 다시 찾아보시겠어요?
    </p>
    <div class="mt-8 flex flex-wrap gap-3" data-reveal>
      <a href="/" class="btn btn-primary">홈으로</a>
      <a href="/posts" class="btn">전체 글</a>
      <button type="button" class="btn" data-open-palette>검색 <span class="kbd">⌘K</span></button>
    </div>
  </div>
</BaseLayout>
