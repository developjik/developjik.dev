---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import PostRow from '~/components/PostRow.astro';
import SectionHead from '~/components/SectionHead.astro';
import { SITE, FEATURED_POSTS } from '~/consts';
import {
  getAllPosts,
  tagCounts,
  getAllSeries,
  SERIES,
  groupByYear,
  formatDate,
  readingMinutes,
  tagSlug,
} from '~/lib/posts';

const posts = await getAllPosts();
const tags = tagCounts(posts);
const series = getAllSeries(posts);
const years = groupByYear(posts);
const featured = FEATURED_POSTS.map((slug) => posts.find((p) => p.id === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);
const latest = posts.slice(0, 7);
const flagship = SERIES['frontend-ai-ops'];
const flagshipCount = series.find((s) => s.id === 'frontend-ai-ops')?.count ?? 0;
const volume = new Date().getFullYear() - SITE.since + 1;

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'ko',
    author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.title,
    url: SITE.url,
    blogPost: posts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      datePublished: p.data.date.toISOString(),
      url: new URL('/posts/' + p.id, SITE.url).href,
    })),
  },
]);
---

<BaseLayout jsonLd={jsonLd}>
  <!-- ============ 표제지 ============ -->
  <section class="border-b border-line">
    <div class="shell grid gap-12 py-16 md:py-24 lg:grid-cols-[1.2fr_0.8fr] lg:gap-20">
      <div>
        <p class="kicker mb-6" data-reveal>agent-era frontend journal</p>
        <h1 class="hero-title text-balance" data-reveal>
          프론트엔드 엔지니어,<br />
          <span class="accent">에이전트 시대</span>를<br class="sm:hidden" />
          기록합니다
        </h1>
        <p class="lede mt-7 max-w-xl" data-reveal>
          AI가 코드를 쓰는 시대에 개발자의 일은 검증과 운영으로 옮겨갑니다.
          실무에서 바로 쓰는 운영 플레이북과 웹 플랫폼 노트를 {posts.length}편 기록했습니다.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
          <a href="/posts" class="btn btn-primary">
            최신 글 읽기
            <span aria-hidden>→</span>
          </a>
          <a href="/series/frontend-ai-ops" class="btn">시리즈 보기</a>
          <button
            type="button"
            class="btn !border-transparent !bg-transparent font-mono text-xs text-faint hover:!text-accent"
            data-open-palette
          >
            또는 <span class="kbd">⌘K</span> 검색
          </button>
        </div>
      </div>

      <!-- 색인 카드 : 표지 안의 목차 -->
      <aside class="card self-start p-7 md:p-8" data-reveal aria-label="블로그 색인">
        <div class="index-head">
          <p class="kicker">Index</p>
          <p class="font-mono text-[0.62rem] tracking-[0.16em] text-faint">VOL.{volume}</p>
        </div>
        <nav class="mt-2" aria-label="블로그 색인">
          <a href="/posts" class="index-row">
            <span class="no">01</span>
            <span class="label">전체 글</span>
            <span class="count tabular">{posts.length}</span>
          </a>
          <a href="/series" class="index-row">
            <span class="no">02</span>
            <span class="label">시리즈</span>
            <span class="count tabular">{flagshipCount}편 연재</span>
          </a>
          <a href="/tags" class="index-row">
            <span class="no">03</span>
            <span class="label">태그</span>
            <span class="count tabular">{tags.length}</span>
          </a>
          <a href="/archives" class="index-row">
            <span class="no">04</span>
            <span class="label">아카이브</span>
            <span class="count tabular">{years.length}개 연도</span>
          </a>
          <a href="/about" class="index-row">
            <span class="no">05</span>
            <span class="label">소개</span>
            <span class="count" aria-hidden>→</span>
          </a>
        </nav>
        <p class="mt-5 border-t border-line pt-4 font-mono text-[0.68rem] leading-relaxed text-faint">
          {posts[posts.length - 1] ? formatDate(posts[posts.length - 1].data.date) : ''} — ongoing
          · 최근 업데이트 {posts[0] ? formatDate(posts[0].data.date) : ''}
        </p>
      </aside>
    </div>
  </section>

  <!-- ============ 표제 글 ============ -->
  <section class="section">
    <div class="shell">
      <SectionHead kicker="No.01 — Selected" title="대표 글" href="/posts" />
      <div class="grid gap-5 md:grid-cols-3">
        {featured.map((p) => <PostCard post={p} minutes={readingMinutes(p.body ?? '')} featured />)}
      </div>
    </div>
  </section>

  <!-- ============ 시리즈 ============ -->
  <section class="section pt-0">
    <div class="shell">
      <a
        href="/series/frontend-ai-ops"
        class="card card-hover group relative block overflow-hidden p-8 md:p-10"
        data-reveal
      >
        <div class="relative grid gap-8 md:grid-cols-[1.5fr_1fr] md:items-center">
          <div>
            <p class="kicker mb-3">연재 중 · {flagshipCount}편</p>
            <h2 class="font-display text-2xl font-bold leading-snug tracking-tight transition-colors group-hover:text-accent md:text-[1.8rem]">
              {flagship.title}
            </h2>
            <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-soft">{flagship.description}</p>
            <p class="mt-6 font-mono text-xs text-accent">
              시리즈 전체 보기 <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden>→</span>
            </p>
          </div>
          <div class="md:pl-8">
            <div class="grid grid-cols-2 gap-4 md:grid-cols-1">
              <div>
                <p class="font-display text-4xl font-bold tabular text-accent">{flagshipCount}<span class="text-lg text-faint">편</span></p>
                <p class="mt-1 font-mono text-[0.68rem] tracking-widest text-faint">EPISODES</p>
              </div>
              <div class="series-bar mt-3 self-center md:w-full"><div style={'width:' + Math.min(100, (flagshipCount / 24) * 100) + '%'}></div></div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ============ 최근 글 ============ -->
  <section class="section pt-0">
    <div class="shell">
      <SectionHead kicker="No.02 — Latest" title="최근 글" href="/posts" />
      <div class="timeline-rail ml-1">
        {latest.map((p) => <PostRow post={p} />)}
      </div>
    </div>
  </section>

  <!-- ============ 주제 ============ -->
  <section class="section pt-0">
    <div class="shell">
      <SectionHead kicker="No.03 — Topics" title="자주 다루는 주제" href="/tags" />
      <div class="flex flex-wrap gap-2.5" data-reveal>
        {tags.slice(0, 14).map(([tag, count]) => (
          <a href={'/tags/' + tagSlug(tag)} class="chip !px-3.5 !py-1.5 !text-xs">
            {tag} <span class="text-faint tabular">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
