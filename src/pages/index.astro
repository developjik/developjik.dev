---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookStage from '~/components/BookStage.astro';
import PostCard from '~/components/PostCard.astro';
import PostRow from '~/components/PostRow.astro';
import SectionHead from '~/components/SectionHead.astro';
import { SITE, FEATURED_POSTS } from '~/consts';
import {
  getAllPosts,
  tagCounts,
  getAllSeries,
  SERIES,
  readingMinutes,
  tagSlug,
} from '~/lib/posts';

const posts = await getAllPosts();
const tags = tagCounts(posts);
const series = getAllSeries(posts);
const featured = FEATURED_POSTS.map((slug) => posts.find((p) => p.id === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);
const latest = posts.slice(0, 7);
const flagship = SERIES['frontend-ai-ops'];
const flagshipCount = series.find((s) => s.id === 'frontend-ai-ops')?.count ?? 0;
// 목표값은 SERIES 정의(goal)를 따른다 — 페이지마다 하드코딩하지 않는다.
const seriesGoal = flagship.goal ?? flagshipCount;
const flagshipDone = flagshipCount >= seriesGoal;

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'ko',
    author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.title,
    url: SITE.url,
    blogPost: posts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      datePublished: p.data.date.toISOString(),
      url: new URL('/posts/' + p.id, SITE.url).href,
    })),
  },
]);
---

<BaseLayout jsonLd={jsonLd}>
  <!-- ============ 히어로 : M3 3D 스테이지 × M2 프리시전 다크 ============ -->
  <section class="border-b border-line">
    <div class="shell grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div data-reveal>
        <BookStage kick={`${posts.length} posts · drag to rotate`} />
      </div>

      <div>
        <p class="kicker mb-6" data-reveal>agent-era frontend engineer</p>
        <h1 class="hero-title text-balance" data-reveal>
          책 무대 위의<br />
          <span class="accent">{posts.length}편</span> 기록
        </h1>

        <div class="mt-8 flex items-end gap-4" data-reveal>
          <p
            class="font-mono text-6xl leading-none font-bold tracking-tighter tabular"
            data-post-counter
            data-count={posts.length}
            aria-label={`전체 글 ${posts.length}편`}
          >
            0
          </p>
          <div class="pb-1">
            <p class="font-mono text-[0.68rem] tracking-[0.16em] text-faint">
              POSTS · {flagshipCount} EPISODES
            </p>
            <p class="mt-1 font-mono text-[0.68rem] tracking-[0.16em] text-faint">
              {tags.length} TAGS · EST. {SITE.since}
            </p>
          </div>
        </div>

        <p class="lede mt-7 max-w-xl" data-reveal>
          AI가 코드를 쓰는 시대에 개발자의 일은 검증과 운영으로 옮겨갑니다.
          실무에서 바로 쓰는 운영 플레이북과 웹 플랫폼 노트를 {posts.length}편 기록했습니다.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
          <a href="/posts" class="btn btn-primary">
            최신 글 읽기
            <span aria-hidden>→</span>
          </a>
          <a href="/series/frontend-ai-ops" class="btn">시리즈 보기</a>
          <button
            type="button"
            class="btn !border-transparent !bg-transparent font-mono text-xs text-faint hover:!text-accent"
            data-open-palette
          >
            또는 <span class="kbd">⌘K</span> 검색
          </button>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ 표제 글 ============ -->
  <section class="section">
    <div class="shell">
      <SectionHead kicker="No.01 — Selected" title="대표 글" href="/posts" />
      <div class="grid gap-5 md:grid-cols-3">
        {featured.map((p) => <PostCard post={p} minutes={readingMinutes(p.body ?? '')} featured />)}
      </div>
    </div>
  </section>

  <!-- ============ 시리즈 ============ -->
  <section class="section pt-0">
    <div class="shell">
      <a
        href="/series/frontend-ai-ops"
        class="card card-hover group relative block overflow-hidden p-8 md:p-10"
        data-reveal
      >
        <div class="relative grid gap-8 md:grid-cols-[1.5fr_1fr] md:items-center">
          <div>
            <p class="kicker mb-3">{flagshipDone ? '완결' : '연재 중'} · {flagshipCount}편</p>
            <h2 class="font-display text-2xl font-bold leading-snug tracking-tight transition-colors group-hover:text-accent md:text-[1.8rem]">
              {flagship.title}
            </h2>
            <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-soft">{flagship.description}</p>
            <p class="mt-6 font-mono text-xs text-accent">
              시리즈 전체 보기 <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden>→</span>
            </p>
          </div>
          <div class="md:pl-8">
            <div class="grid grid-cols-2 gap-4 md:grid-cols-1">
              <div>
                <p class="font-display text-4xl font-bold tabular text-accent">{flagshipCount}<span class="text-lg text-faint">편</span></p>
                <p class="mt-1 font-mono text-[0.68rem] tracking-widest text-faint">EPISODES</p>
              </div>
              <div class="series-bar mt-3 self-center md:w-full"><div style={'width:' + Math.min(100, (flagshipCount / seriesGoal) * 100) + '%'}></div></div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ============ 최근 글 ============ -->
  <section class="section pt-0">
    <div class="shell">
      <SectionHead kicker="No.02 — Latest" title="최근 글" href="/posts" />
      <div class="timeline-rail ml-1">
        {latest.map((p) => <PostRow post={p} />)}
      </div>
    </div>
  </section>

  <!-- ============ 주제 ============ -->
  <section class="section pt-0">
    <div class="shell">
      <SectionHead kicker="No.03 — Topics" title="자주 다루는 주제" href="/tags" />
      <div class="flex flex-wrap gap-2.5" data-reveal>
        {tags.slice(0, 14).map(([tag, count]) => (
          <a href={'/tags/' + tagSlug(tag)} class="chip !px-3.5 !py-1.5 !text-xs">
            {tag} <span class="text-faint tabular">{count}</span>
          </a>
        ))}
      </div>
    </div>

  </section>

<script>
  // M2 카운터 틱 — reduced-motion 즉시 표시
  function initPostCounter() {
    document.querySelectorAll<HTMLElement>('[data-post-counter]').forEach((el) => {
      if (el.dataset.done === '1') return;
      el.dataset.done = '1';
      const target = Number(el.dataset.count ?? '0');
      if (Number.isNaN(target)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.textContent = String(target);
        return;
      }
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 900);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
  document.addEventListener('astro:page-load', initPostCounter);
  initPostCounter();
</script>
</BaseLayout>
