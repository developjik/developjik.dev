---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import PostRow from '~/components/PostRow.astro';
import SectionHead from '~/components/SectionHead.astro';
import { SITE, FEATURED_POSTS } from '~/consts';
import { getAllPosts, tagCounts, readingMinutes, getAllSeries, SERIES, tagSlug } from '~/lib/posts';

const posts = await getAllPosts();
const tags = tagCounts(posts);
const series = getAllSeries(posts);
const featured = FEATURED_POSTS.map((slug) => posts.find((p) => p.id === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);
const latest = posts.slice(0, 7);
const flagship = SERIES['frontend-ai-ops'];
const flagshipCount = series.find((s) => s.id === 'frontend-ai-ops')?.count ?? 0;

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'ko',
    author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.title,
    url: SITE.url,
    blogPost: posts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      datePublished: p.data.date.toISOString(),
      url: new URL('/posts/' + p.id, SITE.url).href,
    })),
  },
]);
---

<BaseLayout jsonLd={jsonLd}>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg absolute inset-0" aria-hidden></div>
    <div class="glow-accent absolute -top-32 left-1/2 h-96 w-[42rem] -translate-x-1/2 opacity-70" aria-hidden></div>
    <div class="shell relative grid items-center gap-14 py-16 md:py-24 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 font-mono text-xs text-soft" data-reveal>
          <span class="status-dot"></span>
          shipping · agent-era frontend
        </p>
        <h1 class="hero-title text-balance" data-reveal>
          프론트엔드 엔지니어,<br />
          <span class="accent">에이전트 시대</span>를<br class="sm:hidden" />
          기록합니다
        </h1>
        <p class="mt-6 max-w-xl text-[1.02rem] leading-relaxed text-soft" data-reveal>
          AI가 코드를 쓰는 시대에 개발자의 일은 검증과 운영으로 옮겨갑니다.
          실무에서 바로 쓰는 운영 플레이북과 웹 플랫폼 노트를 {posts.length}편 기록했습니다.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
          <a href="/posts" class="btn btn-primary">
            최신 글 읽기
            <span aria-hidden>→</span>
          </a>
          <a href="/series/frontend-ai-ops" class="btn">시리즈 보기</a>
          <button type="button" class="btn !border-transparent !bg-transparent font-mono text-xs text-faint hover:!text-accent" data-open-palette>
            또는 <span class="kbd">⌘K</span> 검색
          </button>
        </div>
      </div>

      <div class="terminal mx-auto w-full max-w-md lg:mx-0" data-reveal>
        <div class="terminal-bar">
          <span class="terminal-dot" style="background:#ff5f57"></span>
          <span class="terminal-dot" style="background:#febc2e"></span>
          <span class="terminal-dot" style="background:#28c840"></span>
          <span class="ml-2 text-[0.68rem] text-faint">~/developjik — zsh</span>
        </div>
        <div class="terminal-body">
          <div><span class="cmd">$</span> whoami</div>
          <div class="out">developjik — frontend engineer</div>
          <div><span class="cmd">$</span> cat focus.txt</div>
          <div class="out">프론트엔드 · AI 운영 · DX · 웹 플랫폼</div>
          <div><span class="cmd">$</span> ls posts/ | wc -l</div>
          <div class="out">{posts.length}</div>
          <div><span class="cmd">$</span> <span class="caret"></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="border-b border-line">
    <div class="shell grid grid-cols-2 divide-line md:grid-cols-4 md:divide-x" data-reveal>
      <div class="px-2 py-8 text-center md:py-10">
        <p class="font-display text-3xl font-bold tabular md:text-4xl">{posts.length}</p>
        <p class="mt-1.5 font-mono text-xs tracking-widest text-faint">POSTS</p>
      </div>
      <div class="px-2 py-8 text-center md:py-10">
        <p class="font-display text-3xl font-bold tabular text-accent md:text-4xl">{flagshipCount}</p>
        <p class="mt-1.5 font-mono text-xs tracking-widest text-faint">SERIES EPISODES</p>
      </div>
      <div class="px-2 py-8 text-center md:py-10">
        <p class="font-display text-3xl font-bold tabular md:text-4xl">{tags.length}</p>
        <p class="mt-1.5 font-mono text-xs tracking-widest text-faint">TAGS</p>
      </div>
      <div class="px-2 py-8 text-center md:py-10">
        <p class="font-display text-3xl font-bold tabular md:text-4xl">{new Date().getFullYear() - SITE.since + 1}<span class="text-lg text-faint">년차</span></p>
        <p class="mt-1.5 font-mono text-xs tracking-widest text-faint">SINCE {SITE.since}</p>
      </div>
    </div>
  </section>

  <!-- ============ FEATURED ============ -->
  <section class="section">
    <div class="shell">
      <SectionHead kicker="01 · Selected" title="대표 글" href="/posts" />
      <div class="grid gap-5 md:grid-cols-3">
        {featured.map((p) => <PostCard post={p} minutes={readingMinutes(p.body ?? '')} featured />)}
      </div>
    </div>
  </section>

  <!-- ============ SERIES BANNER ============ -->
  <section class="section pt-0">
    <div class="shell">
      <a
        href="/series/frontend-ai-ops"
        class="card card-hover group relative block overflow-hidden p-8 md:p-10"
        data-reveal
      >
        <div class="glow-accent absolute -right-24 -top-24 h-72 w-72 opacity-60" aria-hidden></div>
        <div class="relative grid gap-8 md:grid-cols-[1.5fr_1fr] md:items-center">
          <div>
            <p class="kicker mb-3">연재 중 · {flagshipCount}편</p>
            <h2 class="font-display text-2xl font-bold tracking-tight transition-colors group-hover:text-accent md:text-[1.8rem]">
              {flagship.title}
            </h2>
            <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-soft">{flagship.description}</p>
            <p class="mt-6 font-mono text-xs text-accent">
              시리즈 전체 보기 <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden>→</span>
            </p>
          </div>
          <div class="md:pl-8">
            <div class="grid grid-cols-2 gap-4 md:grid-cols-1">
              <div>
                <p class="font-display text-4xl font-bold tabular text-accent">{flagshipCount}<span class="text-lg text-faint">편</span></p>
                <p class="mt-1 font-mono text-[0.68rem] tracking-widest text-faint">EPISODES</p>
              </div>
              <div class="series-bar mt-3 self-center md:w-full"><div style={'width:' + Math.min(100, (flagshipCount / 24) * 100) + '%'}></div></div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ============ LATEST ============ -->
  <section class="section pt-0">
    <div class="shell">
      <SectionHead kicker="02 · Latest" title="최근 글" href="/posts" />
      <div class="timeline-rail ml-1">
        {latest.map((p) => <PostRow post={p} />)}
      </div>
    </div>
  </section>

  <!-- ============ TOPICS ============ -->
  <section class="section pt-0">
    <div class="shell">
      <SectionHead kicker="03 · Topics" title="자주 다루는 주제" href="/tags" />
      <div class="flex flex-wrap gap-2.5" data-reveal>
        {tags.slice(0, 14).map(([tag, count]) => (
          <a href={'/tags/' + tagSlug(tag)} class="chip !px-3.5 !py-1.5 !text-xs">
            {tag} <span class="text-faint tabular">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
