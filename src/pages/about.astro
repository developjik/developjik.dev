---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/consts';

const projects = [
  {
    name: 'confluence-studio',
    desc: 'Confluence를 위한 로컬-first 리서치 워크스페이스 — Tauri + Rust',
    url: 'https://github.com/developjik/confluence-studio',
    tag: 'Rust · Tauri',
  },
  {
    name: 'damon-agent-core',
    desc: '멀티 에이전트 오케스트레이션 코어 — 계약 기반 검증과 세션 관리',
    url: 'https://github.com/developjik/damon-agent-core',
    tag: 'Agents · Rust',
  },
  {
    name: 'ai-note',
    desc: 'AI 어시스턴트와 함께 쓰는 노트 앱 — 로컬 마크다운 + LLM 파이프라인',
    url: 'https://github.com/developjik/ai-note',
    tag: 'LLM · Frontend',
  },
  {
    name: 'assignment-map',
    desc: '과제·이슈를 시간축 지도로 시각화하는 프로젝트 트래커',
    url: 'https://github.com/developjik/assignment-map',
    tag: 'Viz · TypeScript',
  },
];

const stack = ['TypeScript', 'React', 'Next.js', 'Astro', 'Node.js', 'Rust', 'Tauri', 'AWS', 'Terraform', 'Playwright', 'GitHub Actions', 'Biome'];
const interests = ['AI Agents', 'MCP', 'DX', '웹 성능', '운영 플레이북', '기술 글쓰기'];

const principles = [
  { title: '검증은 생성보다 비싸다', body: 'AI가 코드를 쓰는 시대에, 개발자의 가치는 변경을 안전하게 검증하고 운영하는 데서 나온다고 믿습니다. 이 블로그의 시리즈도 그 고민의 기록입니다.' },
  { title: '기록은 자산이다', body: '배운 것을 남에게 설명할 수 있어야 내 것이 됩니다. 문서화와 회고를 습관으로 만들고, 그 결과를 공개합니다.' },
  { title: '작게 자주 배포한다', body: '트렁크 기반 개발과 기능 플래그로 변경을 잘게 쪼개 검증합니다. 큰 사고보다 작은 학습을 반복합니다.' },
];
---

<BaseLayout title="소개" description="프론트엔드 엔지니어 developjik 소개 — 에이전트 시대의 프론트엔드, AI 운영, DX.">
  <!-- hero -->
  <section class="border-b border-line">
    <div class="shell py-16 md:py-24">
      <div class="flex flex-col items-start gap-8 md:flex-row md:items-center" data-reveal>
        <img
          src="https://github.com/developjik.png"
          alt="developjik 프로필"
          width="112"
          height="112"
          loading="eager"
          class="rounded-sm border border-line"
        />
        <div>
          <p class="kicker mb-3">About</p>
          <h1 class="font-display text-4xl font-bold tracking-tight md:text-5xl">developjik</h1>
          <p class="mt-3 text-lg text-soft">프론트엔드 엔지니어 · 에이전트 시대 인프라 만드는 중</p>
          <p class="mt-4 flex items-center gap-2 font-mono text-xs text-faint">
            <span class="status-dot"></span> open to interesting problems
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- bio -->
  <section class="section">
    <div class="shell max-w-3xl" data-reveal>
      <p class="kicker mb-4">Bio</p>
      <div class="space-y-5 text-[1.02rem] leading-[1.85] text-soft">
        <p>
          안녕하세요, <strong class="text-ink">developjik</strong>입니다. React와 TypeScript를 중심으로 웹 제품을 만들어 왔고,
          지금은 AI 에이전트가 개발 워크플로에 들어오는 시대에 프론트엔드 엔지니어의 역할이 어떻게 변하는지 실험하고 있습니다.
        </p>
        <p>
          이 블로그는 그 실험의 기록입니다. 단순한 사용법 정리보다, <a class="u" href="/series/frontend-ai-ops">실무 운영 플레이북</a>처럼
          바로 써먹을 수 있는 글을 쓰려고 노력합니다. 성능 최적화, 접근성, 유지보수 가능한 설계를 중요하게 생각하고,
          배운 것을 문서로 남기고 공유하는 습관을 가지고 있습니다.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-3">
        {[
          { k: 'React / Next.js', v: '프론트엔드 실무' },
          { k: 'AWS / IaC', v: '웹 플랫폼 운영' },
          { k: 'Rust / Agents', v: '실험과 도구 제작' },
        ].map((item) => (
          <div class="card p-5">
            <p class="font-mono text-xs text-accent">{item.k}</p>
            <p class="mt-2 text-sm text-soft">{item.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- now shipping -->
  <section class="section pt-0">
    <div class="shell">
      <p class="kicker mb-3" data-reveal>Now Shipping</p>
      <h2 class="mb-8 font-display text-2xl font-bold tracking-tight md:text-[1.7rem]" data-reveal>지금 만들고 있는 것들</h2>
      <div class="grid gap-5 sm:grid-cols-2" data-reveal>
        {projects.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="card card-hover group p-6">
            <div class="flex items-center justify-between gap-3">
              <p class="font-mono text-[0.95rem] font-semibold text-ink transition-colors group-hover:text-accent">{p.name}</p>
              <span class="chip">{p.tag}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-soft">{p.desc}</p>
            <p class="mt-4 font-mono text-xs text-faint transition-colors group-hover:text-accent">github.com/developjik/{p.name} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- principles -->
  <section class="section pt-0">
    <div class="shell max-w-3xl">
      <p class="kicker mb-3" data-reveal>Principles</p>
      <h2 class="mb-8 font-display text-2xl font-bold tracking-tight md:text-[1.7rem]" data-reveal>일하는 방식</h2>
      <div class="space-y-4" data-reveal>
        {principles.map((p, i) => (
          <div class="card flex gap-5 p-6">
            <span class="font-display text-2xl font-bold text-accent/40 tabular">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-[650]">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-soft">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- stack & interests -->
  <section class="section pt-0">
    <div class="shell max-w-3xl">
      <p class="kicker mb-3" data-reveal>Toolbox</p>
      <h2 class="mb-8 font-display text-2xl font-bold tracking-tight md:text-[1.7rem]" data-reveal>도구와 관심사</h2>
      <div class="space-y-6" data-reveal>
        <div class="flex flex-wrap gap-2">
          {stack.map((s) => <span class="chip !px-3 !py-1 !text-xs">{s}</span>)}
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-mono text-xs text-faint">interests:</span>
          {interests.map((s) => <span class="chip !px-3 !py-1 !text-xs !border-accent/30 !text-accent">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- contact -->
  <section class="section pt-0">
    <div class="shell max-w-3xl">
      <div class="card p-8 md:p-10" data-reveal>
        <p class="kicker mb-3">Contact</p>
        <h2 class="font-display text-2xl font-bold tracking-tight">이야기하고 싶으신가요?</h2>
        <p class="mt-3 max-w-xl text-[0.95rem] leading-relaxed text-soft">
          기술적인 피드백, 이직 관련 이야기, 협업 제안 모두 환영합니다. 블로그 글에 대한 오탐도 이슈로 알려주세요.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={SITE.github} target="_blank" rel="noopener" class="btn btn-primary">GitHub <span aria-hidden>→</span></a>
          <a href={SITE.repo + '/issues'} target="_blank" rel="noopener" class="btn">블로그 이슈</a>
          <a href="/rss.xml" class="btn">RSS 구독</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
