---
import { SITE } from '~/consts';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/posts', label: '글' },
  { href: '/series', label: '시리즈' },
  { href: '/tags', label: '태그' },
  { href: '/archives', label: '아카이브' },
  { href: '/about', label: '소개' },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<header class="site-header no-print">
  <div class="shell flex h-[4.25rem] items-center justify-between gap-6">
    <a href="/" class="group flex items-baseline gap-2.5" aria-label="홈으로">
      <span class="font-display text-[1.4rem] font-bold leading-none tracking-tight">
        developjik<span class="text-accent">.dev</span>
      </span>
      <span class="hidden font-mono text-[0.62rem] uppercase tracking-[0.18em] text-faint sm:inline">
        est. {SITE.since}
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="주요 메뉴">
      {links.map((l) => (
        <a href={l.href} class="nav-link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5">
      <button type="button" class="icon-btn" data-open-palette aria-label="검색 (⌘K)" title="검색 ⌘K">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </button>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="테마 전환" title="라이트/다크 전환">
        <svg class="hidden size-[17px] [data-theme='dark']_&:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19" /></svg>
        <svg class="size-[17px] [data-theme='dark']_&:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z" /></svg>
      </button>
      <a href={SITE.github} class="icon-btn" aria-label="GitHub" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.04-1.41-4.04-1.41-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.7.8.58A11.5 11.5 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z" /></svg>
      </a>
      <button type="button" class="icon-btn md:hidden" data-menu-toggle aria-label="메뉴 열기" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <div class="hidden border-t border-line md:hidden" data-mobile-menu>
    <nav class="shell flex flex-col py-3" aria-label="모바일 메뉴">
      {links.map((l) => (
        <a href={l.href} class="py-2.5 text-[0.95rem] font-medium text-soft hover:text-ink" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
