<div id="command-palette" class="palette-backdrop" role="dialog" aria-modal="true" aria-label="블로그 검색">
  <div class="palette-panel">
    <div class="flex items-center gap-3 border-b border-line px-5 py-4">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-faint"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input
        id="palette-input"
        class="palette-input"
        type="text"
        placeholder="포스트 검색… (제목 · 내용)"
        autocomplete="off"
        spellcheck="false"
      />
      <span class="kbd shrink-0">ESC</span>
    </div>
    <div id="palette-results" class="max-h-[22rem] overflow-y-auto py-2" role="listbox"></div>
    <div class="flex items-center justify-between border-t border-line px-5 py-2.5 font-mono text-[0.65rem] text-faint">
      <span><span class="kbd">↑↓</span> 이동 · <span class="kbd">↵</span> 열기</span>
      <span>powered by pagefind</span>
    </div>
  </div>
</div>

<script>
  function initPalette() {
    const backdropEl = document.getElementById('command-palette');
    const inputEl = document.getElementById('palette-input') as HTMLInputElement | null;
    const resultsElEl = document.getElementById('palette-results');
    if (!backdropEl || !inputEl || !resultsElEl) return;
    if (backdropEl.dataset.initialized === '1') return;
    backdropEl.dataset.initialized = '1';
    const backdrop: HTMLElement = backdropEl;
    const input: HTMLInputElement = inputEl;
    const resultsEl: HTMLElement = resultsElEl;

    let pagefind: any = null;
    let loading = false;
    let activeIndex = -1;
    let items: Array<{ url: string; title: string; meta: string }> = [];
    let debounceTimer: any = null;

    function open() {
      backdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
      input.focus();
      if (!pagefind && !loading) loadPagefind();
    }
    function close() {
      backdrop.classList.remove('open');
      document.body.style.overflow = '';
      input.value = '';
      renderIdle();
    }

    function loadPagefind() {
      loading = true;
      const pfUrl = '/pagefind' + '/pagefind.js';
      import(/* @vite-ignore */ pfUrl)
        .then(async (mod: any) => {
          await mod.options?.();
          pagefind = mod;
          if (input.value.trim()) runSearch(input.value);
        })
        .catch(() => {
          renderMessage('검색 인덱스를 불러올 수 없습니다.');
        })
        .finally(() => { loading = false; });
    }

    function renderIdle() {
      resultsEl.innerHTML = '';
      const hint = document.createElement('div');
      hint.className = 'px-5 py-6 text-center font-mono text-xs text-faint';
      hint.textContent = '검색어를 입력하세요 — 제목과 본문 전문(full-text) 검색';
      resultsEl.appendChild(hint);
    }

    function renderMessage(msg: string) {
      resultsEl.innerHTML = '';
      const el = document.createElement('div');
      el.className = 'px-5 py-6 text-center font-mono text-xs text-faint';
      el.textContent = msg;
      resultsEl.appendChild(el);
    }

    function renderResults(list: any[], query: string) {
      resultsEl.innerHTML = '';
      items = [];
      activeIndex = -1;
      if (list.length === 0) {
        renderMessage('결과 없음: ' + query);
        return;
      }
      list.slice(0, 8).forEach((r) => {
        const title = (r.meta?.title ?? '(제목 없음)') as string;
        const url = (r.url as string).replace(/\/+$/, '');
        const meta = (r.meta?.date ?? '') as string;
        items.push({ url, title, meta });
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'palette-result';
        btn.setAttribute('role', 'option');
        const t = document.createElement('span');
        t.className = 'r-title flex-1 truncate';
        t.textContent = title;
        const m = document.createElement('span');
        m.className = 'r-meta';
        m.textContent = meta;
        btn.appendChild(t);
        btn.appendChild(m);
        btn.addEventListener('click', () => {
          window.location.assign(url);
        });
        resultsEl.appendChild(btn);
      });
    }

    async function runSearch(q: string) {
      if (!pagefind) {
        renderMessage('검색 인덱스 로딩 중…');
        return;
      }
      const search = await pagefind.search(q);
      const top = search.results.slice(0, 8);
      const data = await Promise.all(top.map((r: any) => r.data()));
      renderResults(data, q);
    }

    function moveActive(delta: number) {
      const buttons = resultsEl.querySelectorAll('.palette-result');
      if (buttons.length === 0) return;
      activeIndex = (activeIndex + delta + buttons.length) % buttons.length;
      buttons.forEach((b, i) => b.setAttribute('data-active', i === activeIndex ? '1' : '0'));
      (buttons[activeIndex] as HTMLElement).scrollIntoView({ block: 'nearest' });
    }

    function goActive() {
      const target = items[activeIndex] ?? items[0];
      if (target) window.location.assign(target.url);
    }

    input.addEventListener('input', () => {
      const q = input.value.trim();
      clearTimeout(debounceTimer);
      if (!q) { renderIdle(); return; }
      renderMessage('검색 중…');
      debounceTimer = setTimeout(() => runSearch(q), 140);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); moveActive(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); moveActive(-1); }
      else if (e.key === 'Enter') { e.preventDefault(); goActive(); }
    });

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) close();
    });

    document.querySelectorAll('[data-open-palette]').forEach((btn) => {
      btn.addEventListener('click', open);
    });

    document.addEventListener('keydown', (e) => {
      const k = e.key.toLowerCase();
      const typing = ['input', 'textarea'].includes((document.activeElement as HTMLElement)?.tagName?.toLowerCase() ?? '');
      if ((e.metaKey || e.ctrlKey) && k === 'k') {
        e.preventDefault();
        backdrop.classList.contains('open') ? close() : open();
      } else if (k === 'escape' && backdrop.classList.contains('open')) {
        close();
      } else if (k === '/' && !typing && !backdrop.classList.contains('open')) {
        e.preventDefault();
        open();
      }
    });

    renderIdle();
  }

  document.addEventListener('astro:page-load', initPalette);
  initPalette();
</script>
