---
import { SITE } from '~/consts';
const year = new Date().getFullYear();
---

<footer class="site-footer no-print mt-8">
  <div class="shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-4">
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-accent text-accent-ink font-mono text-base font-bold">d</span>
        <span class="font-display font-bold">developjik<span class="text-accent">.dev</span></span>
      </a>
      <p class="max-w-sm text-sm leading-relaxed text-soft">
        에이전트 시대의 프론트엔드 엔지니어. 배우고 검증한 것을 기록하고, 기록한 것을 운영합니다.
      </p>
      <p class="flex items-center gap-2 font-mono text-xs text-faint">
        <span class="status-dot"></span> now shipping — confluence-studio, damon-agent-core
      </p>
    </div>

    <nav aria-label="푸터 메뉴" class="space-y-3 text-sm">
      <p class="kicker">Navigate</p>
      <ul class="space-y-2.5 text-soft">
        <li><a class="hover:text-accent" href="/posts">전체 글</a></li>
        <li><a class="hover:text-accent" href="/series/frontend-ai-ops">프론트엔드 AI 실무 시리즈</a></li>
        <li><a class="hover:text-accent" href="/tags">태그</a></li>
        <li><a class="hover:text-accent" href="/archives">아카이브</a></li>
        <li><a class="hover:text-accent" href="/about">소개</a></li>
      </ul>
    </nav>

    <nav aria-label="외부 링크" class="space-y-3 text-sm">
      <p class="kicker">Elsewhere</p>
      <ul class="space-y-2.5 text-soft">
        <li><a class="hover:text-accent" href={SITE.github} rel="noopener">GitHub</a></li>
        <li><a class="hover:text-accent" href="/rss.xml">RSS</a></li>
        <li><a class="hover:text-accent" href={SITE.repo} rel="noopener">블로그 소스</a></li>
        <li>
          <button type="button" class="text-left hover:text-accent" data-open-palette>
            검색 <span class="kbd ml-1">⌘K</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <div class="shell flex flex-col items-start justify-between gap-2 py-5 font-mono text-xs text-faint sm:flex-row sm:items-center">
      <p>© {SITE.since}–{year} {SITE.author}. 오탐 환영 — 이슈로 알려주세요.</p>
      <p>built with <a class="hover:text-accent" href="https://astro.build" rel="noopener">astro</a> · deployed static · <span class="text-soft">agent-era frontend</span></p>
    </div>
  </div>
</footer>
